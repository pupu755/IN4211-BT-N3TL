# Copy this file to .env and replace every placeholder. Never commit .env.

# PostgreSQL container
POSTGRES_DB=foodhub
POSTGRES_USER=foodhub
POSTGRES_PASSWORD=change-me

# API (read by ASP.NET Core configuration, double underscore means nested key)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=foodhub;Username=foodhub;Password=change-me
Jwt__Key=replace-with-a-random-secret-of-at-least-32-characters
Jwt__Issuer=FoodHub
Jwt__Audience=FoodHub.Clients
